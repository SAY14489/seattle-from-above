---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Seattle From Above", description = "Tracking the biggest visible land changes around the Puget Sound and Mount Rainier, from satellite data." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col">
    <header class="border-b border-neutral-800 sticky top-0 z-20 bg-neutral-950/90 backdrop-blur">
      <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="font-semibold tracking-tight text-lg flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          Seattle From Above
        </a>
        <div class="flex gap-5 text-sm text-neutral-300">
          <a href="/" class="hover:text-white transition-colors">Map</a>
          <a href="/leaderboard" class="hover:text-white transition-colors">Top 100</a>
          <a href="/about" class="hover:text-white transition-colors">About</a>
        </div>
      </nav>
    </header>
    <main class="flex-1 flex flex-col">
      <slot />
    </main>
    <footer class="border-t border-neutral-800 text-xs text-neutral-500 px-4 py-4 text-center space-y-1">
      <p>
        OlmoEarth v1.3 embeddings by Ai2, hosted on Source Cooperative · Contains modified Copernicus Sentinel data · <a href="/about" class="underline hover:text-neutral-300">Data &amp; license</a>
      </p>
      <p>
        Spot something off, or want your neighborhood covered? <a href="mailto:say.analystics.sea@gmail.com" class="underline hover:text-neutral-300">say.analystics.sea@gmail.com</a>
      </p>
    </footer>
  </body>
</html>
